{
  "expo": {
    "name": "VitalQuest",
    "slug": "vitalquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitalquest.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "VitalQuest reads your health data to reward your daily wellness activities.",
        "NSHealthUpdateUsageDescription": "VitalQuest writes workout data back to HealthKit.",
        "NSFaceIDUsageDescription": "Use Face ID to access your private clinical health dashboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0a2e"
      },
      "package": "com.vitalquest.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow VitalQuest to use Face ID to protect your clinical dashboard."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "vitalquest"
  }
}
