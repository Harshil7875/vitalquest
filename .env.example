# ─── Postgres (Health Vault) ───────────────────────────────────────────────────
POSTGRES_USER=vitalquest
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=health_vault

# ─── Redis (Game State + Message Bus) ─────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_jwt_secret_minimum_32_chars
JWT_ALGORITHM=HS256

# ─── PHI Encryption (at-rest, application layer) ──────────────────────────────
# Must be exactly 32 bytes (256-bit key), base64-encoded
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=changeme_base64_encoded_32_byte_key

# ─── Game Economy (GDD v1.8) ───────────────────────────────────────────────────
DAILY_MANA_CAP=300

# ─── Guild Cron Schedule (UTC) ────────────────────────────────────────────────
GUILD_CRON_HOUR=23
GUILD_CRON_MINUTE=59

# ─── Dexcom OAuth / Webhook (v1.4) ────────────────────────────────────────────
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_WEBHOOK_SECRET=

# ─── Other Device Webhooks ────────────────────────────────────────────────────
OURA_WEBHOOK_SECRET=
FITBIT_WEBHOOK_SECRET=

# ─── Push Notification Worker (v1.7) ──────────────────────────────────────────
# APNs (iOS) — requires a .p8 key from Apple Developer Portal
APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.vitalquest.app
APNS_USE_SANDBOX=true

# FCM (Android) — service account key
FCM_SERVER_KEY=

# Queue configuration (shared between services — must match across all containers)
NOTIFICATION_QUEUE_HEALTH_KEY=notify:stream_a
NOTIFICATION_QUEUE_GAME_KEY=notify:stream_b
NOTIFICATION_DLQ_KEY=notify:dlq
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY_S=5
